fn is_prime(n: int) -> bool {
    if (n < 2) { return false; }
    let i: int = 2;
    while (i * i <= n) {
        if (n % i == 0) { return false; }
        i = i + 1;
    }
    return true;
}
fn main() {
    let n: int = 2;
    let count: int = 0;
    while (n < 300000) {
        if (is_prime(n)) { count = count + 1; }
        n = n + 1;
    }
    print(count);
}
