// @title Nested scopes & shadowing
// @desc Inner blocks may shadow outer names; see the scope tree in Semantic Analysis.
// @category basics
fn main() {
    let x: int = 1;
    {
        let x: int = 2;
        print(x);
        {
            let x: int = 3;
            print(x);
        }
        print(x);
    }
    print(x);
}
