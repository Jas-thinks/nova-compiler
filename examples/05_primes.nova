// @title Prime sieve by trial division
// @desc Nested while loops, modulo and boolean logic.
// @category loops
fn is_prime(n: int) -> bool {
    if (n < 2) { return false; }
    let d: int = 2;
    while (d * d <= n) {
        if (n % d == 0) { return false; }
        d = d + 1;
    }
    return true;
}

fn main() {
    let n: int = 2;
    let count: int = 0;
    while (n < 40) {
        if (is_prime(n)) {
            print(n);
            count = count + 1;
        }
        n = n + 1;
    }
    print(count);
}
