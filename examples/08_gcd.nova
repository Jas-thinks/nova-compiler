// @title Euclid's GCD
// @desc A classic loop with modulo; good for stepping in the debugger.
// @category loops
fn gcd(a: int, b: int) -> int {
    while (b != 0) {
        let r: int = a % b;
        a = b;
        b = r;
    }
    return a;
}

fn main() {
    print(gcd(48, 18));
    print(gcd(1071, 462));
    print(gcd(17, 5));
}
