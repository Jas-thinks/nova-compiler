// @title Arrays: bubble sort
// @desc Heap-allocated int[] with literals, new, indexing, assignment and len(); arrays are passed by reference.
// @category arrays
fn swap(a: int[], i: int, j: int) {
    let t: int = a[i];
    a[i] = a[j];
    a[j] = t;
}

fn sort(a: int[]) {
    let n: int = len(a);
    let i: int = 0;
    while (i < n) {
        let j: int = 0;
        while (j < n - 1 - i) {
            if (a[j] > a[j + 1]) { swap(a, j, j + 1); }
            j = j + 1;
        }
        i = i + 1;
    }
}

fn main() {
    let a: int[] = [5, 2, 9, 1, 7, 3];
    sort(a);
    let i: int = 0;
    while (i < len(a)) { print(a[i]); i = i + 1; }
    let squares: int[] = new int[5];
    i = 0;
    while (i < 5) { squares[i] = i * i; i = i + 1; }
    print(squares[4]);
}
